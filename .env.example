# Google Gemini API kaliti (AI yordamchi uchun): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Ixtiyoriy
GEMINI_MODEL=gemini-3.5-flash
# PORT=3000
# Agent ovozi (bepul Edge neyron ovozlari, kalit kerak emas). Ixtiyoriy:
# TTS_VOICE_UZ=uz-UZ-SardorNeural   # yoki uz-UZ-MadinaNeural (ayol)
# TTS_VOICE_RU=ru-RU-SvetlanaNeural
# TTS_VOICE_EN=en-US-AvaNeural
# Ovoz limiti: har bir tashrif buyuruvchiga 10 daqiqada nechta ovoz (standart 30)
# TTS_LIMIT=30
# Hosting proksisi ortida nechta proksi bor (production'da standart 1). Haqiqiy IP aniqlanishi uchun.
# TRUST_PROXY=1
# ElevenLabs ovozi (ixtiyoriy, eng tabiiy). Kalit bo'lmasa yoki kredit tugasa — bepul Edge ovoziga o'tiladi.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_v4          # yoki eleven_v4_turbo (tezroq, ~2 barobar arzon)
# ELEVENLABS_VOICE_UZ=rwtcHtZgYU6HN2zLNBlf   # o‘zbekcha ovoz (standart)
# ELEVENLABS_VOICE_RU=HcaxAsrhw4ByUo4CBCBN   # ruscha ovoz (standart)
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # boshqa tillar uchun (George)
# Birja va broker komissiyalari (%), to'liq xarajat hisobi uchun. Haqiqiy stavkani broker bilan aniqlang.
# Berilmasa — hisobda "komissiyalar kiritilmagan" deb ko'rsatiladi.
# UZEX_FEE_PCT=
# BROKER_FEE_PCT=
# ElevenLabs'ni kalitni o'chirmasdan vaqtincha o'chirish: ELEVENLABS_ENABLED=0
# ELEVENLABS_ENABLED=1

# Narx kuzatuvi (push-bildirishnomalar) — ixtiyoriy
# Kalitlar bo'sh bo'lsa, birinchi ishga tushishda data/vapid.json avtomatik yaratiladi.
# Generatsiya: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Push xizmatlari (Apple/Google) uchun aloqa manzili: mailto:siz@domen.uz yoki https://saytingiz.uz
VAPID_SUBJECT=
# Obunalar necha daqiqada tekshirilsin (standart 10, kamida 2)
ALERT_POLL_MIN=10
